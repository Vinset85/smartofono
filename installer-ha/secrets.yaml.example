# Segreti di Home Assistant: copia questo file in /config/secrets.yaml e
# riempilo con i tuoi valori. Non finisce mai nel repository, perche'
# .gitignore esclude secrets.yaml.
#
# I riferimenti !secret nei package di questo progetto cercano queste chiavi.

# --- Account eWeLink / Sonoff, per aprire il cancello ---------------------
sonoff_username: la-tua-email@esempio.it
sonoff_password: la-tua-password-ewelink

# --- Telecamera Hikvision, se la usi -------------------------------------
# Se non hai una Hikvision, cancella il blocco `switch:` corrispondente da
# packages/configuration.yaml invece di inventare dei valori.
hikvision_host: 192.168.1.110
hikvision_username: admin
hikvision_password: la-password-della-telecamera

# --- LiveKit, per le videochiamate ---------------------------------------
# Genera i segreti con `openssl rand -hex 32`, non riusarli da esempi trovati
# in rete: con questi si entra nelle chiamate.
#
# vc_egress_secret e' l'unico che i package di HA leggono da qui (lo mandano
# nell'header X-VC-Egress per avviare le registrazioni). Deve combaciare con
# EGRESS_SECRET in installer-ha/livekit/start.sh.
vc_egress_secret: generane-uno-con-openssl-rand-hex-24

# Questi due non sono letti da Home Assistant: vanno in
# installer-ha/livekit/livekit.yaml e docker-compose.yml. Sono qui perche' e'
# l'unico posto dove tenere insieme tutti i segreti del progetto.
livekit_api_key: videocitofono
livekit_api_secret: generane-uno-con-openssl-rand-hex-32

# --- Token per i comandi MQTT fra Home Assistant e il Raspberry ----------
# Deve combaciare con `mqtt.cmd_secret` in installer-rpi/app/config/config.yaml
videocitofono_cmd_secret: generane-uno-con-openssl-rand-hex-16
