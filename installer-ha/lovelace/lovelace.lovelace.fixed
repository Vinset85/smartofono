entity.attributes && entity.attributes.all) || [];\n      let i = c.length - 1;\n      if (i < 0 || !c[i]) return '';\n      let it = c[i];\n      if (it.azione === 'apertura') return 'Apertura';\n      if (it.azione === 'risposta_video') return 'Risposta video';\n      if (it.azione === 'risposta_audio') return 'Risposta audio';\n      if (it.azione === 'talkback') return 'Talkback';\n      if (it.stato === 'in_corso' || it.stato === 'chiamata_in_corso') return 'In corso';\n      if (it.stato === 'rifiutata') return 'Rifiutata';\n      if (it.stato === 'risposto') return 'Risposta';\n      return 'Persa';\n  })();\n  let _b = (function(){\n    let c = (entity && entity.attributes && entity.attributes.all) || [];\n      let i = c.length - 1;\n      if (i < 0) return '';\n      let dt = new Date(c[i].timestamp);\n      let now = new Date();\n      let diffMs = now - dt;\n      let diffMin = Math.floor(diffMs / 60000);\n      let diffH = Math.floor(diffMs / 3600000);\n      let diffD = Math.floor(diffMs / 86400000);\n      let pad = n => String(n).padStart(2,'0');\n      let hhmm = pad(dt.getHours()) + ':' + pad(dt.getMinutes());\n      if (diffMin < 1) return 'Adesso';\n      if (diffMin < 60) return diffMin + ' min fa';\n      if (now.toDateString() === dt.toDateString()) return 'Oggi ' + hhmm;\n      let yesterday = new Date(now); yesterday.setDate(now.getDate()-1);\n      if (yesterday.toDateString() === dt.toDateString()) return 'Ieri ' + hhmm;\n      if (diffD < 7) {\n        let dows = ['Dom','Lun','Mar','Mer','Gio','Ven','Sab'];\n        return dows[dt.getDay()] + ' ' + hhmm;\n      }\n      let months = ['gen','feb','mar','apr','mag','giu','lug','ago','set','ott','nov','dic'];\n      return dt.getDate() + ' ' + months[dt.getMonth()] + ' ' + hhmm;\n  })();\n  return _a + ' · ' + _b;\n]]]","icon":"[[[\n  let c = (entity && entity.attributes && entity.attributes.all) || [];\n  let i = c.length - 1;\n  if (i < 0 || !c[i]) return 'mdi:phone-off';\n  let it = c[i];\n  if (it.azione === 'apertura') return 'mdi:door-open';\n  if (it.azione === 'risposta_video') return 'mdi:video';\n  if (it.azione === 'risposta_audio') return 'mdi:phone-in-talk';\n  if (it.azione === 'talkback') return 'mdi:microphone';\n  if (it.stato === 'in_corso' || it.stato === 'chiamata_in_corso') return 'mdi:phone-ring';\n  if (it.stato === 'rifiutata') return 'mdi:phone-cancel';\n  if (it.stato === 'risposto') return 'mdi:phone-check';\n  return 'mdi:phone-missed';\n]]]","show_state":false,"show_label":true,"tap_action":{"action":"call-service","service":"browser_mod.popup","service_data":{"title":"[[[\n  let s = states && states['sensor.registro_videocitofono']; let c = (s && s.attributes && s.attributes.all) || [];\n  let i = c.length - 1;\n  if (i < 0 || !c[i]) return 'Video chiamata';\n  let it = c[i];\n  let label;\n  if (it.azione === 'apertura') label = 'Apertura';\n  else if (it.azione === 'risposta_video') label = 'Risposta video';\n  else if (it.azione === 'risposta_audio') label = 'Risposta audio';\n  else if (it.azione === 'talkback') label = 'Talkback';\n  else if (it.stato === 'in_corso' || it.stato === 'chiamata_in_corso') label = 'In corso';\n  else if (it.stato === 'rifiutata') label = 'Rifiutata';\n  else if (it.stato === 'risposto') label = 'Risposta';\n  else label = 'Persa';\n  let dt = new Date(it.timestamp);\n  let pad = n => String(n).padStart(2,'0');\n  return label + ' - ' + dt.getDate() + '/' + (dt.getMonth()+1) + '/' + dt.getFullYear() + ' ' + pad(dt.getHours()) + ':' + pad(dt.getMinutes());\n]]]","size":"wide","content":{"type":"custom:html-card","content":"[[[\n  let s = states && states['sensor.registro_videocitofono']; let c = (s && s.attributes && s.attributes.all) || [];\n  let i = c.length - 1;\n  if (i < 0) return '<p style=\"padding:24px;text-align:center;\">Nessuna chiamata</p>';\n  let parts = (c[i].video || '').split('/');\n  let fname = parts[parts.length - 1];\n  if (!fname) return '<p style=\"padding:24px;text-