secrets.yaml
*.secret
*.key
*.pem
.env
.env.*
installer-ha/livekit/.secrets

# Documentazione di lavoro dell'impianto reale: contiene credenziali, token,
# la topologia della rete di casa e i backup di Home Assistant (centinaia di
# MB). Niente di tutto questo serve a chi replica il progetto.
docs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
.venv-cad/
venv/
.pytest_cache/

