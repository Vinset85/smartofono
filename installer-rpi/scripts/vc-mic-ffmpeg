#!/bin/bash
# Wrapper per ffmpeg-pulse-mic invocato da go2rtc come root.
#
# CRITICO: usa `exec` per RIMPIAZZARE bash con setpriv, e setpriv
# usa `exec` per rimpiazzarsi con ffmpeg. Risultato: il PID che
# go2rtc traccia E' il vero processo ffmpeg, quindi quando go2rtc
# invia SIGTERM al processo, ffmpeg lo riceve direttamente e muore
# pulito. Niente piu' zombie ffmpeg accumulati.
#
# Senza wrapper: `sudo -u vinset ffmpeg ...` creava 2 processi
# (sudo parent + ffmpeg child); SIGTERM su sudo non veniva
# propagato al ffmpeg child -> ad ogni reload publisher restavano
# decine di ffmpeg orfani che saturavano CPU (load avg 100+).
#
# setpriv e' nativo (util-linux), molto piu' leggero di sudo, non
# crea PAM session e propaga signal correttamente perche' il PID
# e' lo stesso (exec syscall).
#
# Catena audio (RPi mic -> HA): voce naturale, no metallico
#   highpass 120Hz   : taglia rumble basso (vento, AC, vibrazioni)
#   eq 250Hz +1dB    : leggero calore corpo voce
#   eq 1500Hz +2dB   : presence morbida
#   eq 4000Hz -2dB   : taglia zona nasale/metallica del MEMS
#   lowpass 6500Hz   : taglio sibilanti aggressivi
#   volume +12dB     : compensa MEMS Raspiaudio
#   alimiter 0.95    : safety clip
exec setpriv \
    --reuid=vinset --regid=vinset --init-groups \
    --inh-caps=-all \
    -- env \
        XDG_RUNTIME_DIR=/run/user/1000 \
        PULSE_RUNTIME_PATH=/run/user/1000/pulse \
        HOME=/home/vinset \
    ffmpeg -hide_banner -loglevel warning \
        -thread_queue_size 1024 -f pulse -i default \
        -ac 1 -ar 48000 \
        -af "highpass=f=120,equalizer=f=250:t=h:width=200:g=1,equalizer=f=1500:t=h:width=1000:g=2,equalizer=f=4000:t=h:width=1500:g=-2,lowpass=f=6500,volume=12dB,alimiter=limit=0.95" \
        -c:a libopus -b:a 64k -ac 1 -ar 48000 -application voip -frame_duration 20 \
        -vn -f mpegts -
